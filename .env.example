# ── Vercel deployment (server-side, never exposed to the browser) ──────────────
# Set these in your Vercel project settings → Environment Variables
SALLING_API_KEY=your_salling_group_api_key_here

# Used by /api/recipes.js to call Anthropic for recipe ideas based on nearby
# discounted ingredients + user preferences (diet, cooking time, goals).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Local development ──────────────────────────────────────────────────────────
# Option A (recommended): run `vercel dev` instead of `npm run dev`.
#   This starts both the Vite dev server and the /api/* serverless functions,
#   so SALLING_API_KEY and ANTHROPIC_API_KEY above are enough.
#
# Option B: add your key here and run `npm run dev`.
#   The app will call the Salling API directly from the browser (no proxy).
#   Note: /api/recipes still requires `vercel dev` — there is no browser fallback
#   for the Anthropic call (the API key must stay server-side).
# VITE_SALLING_API_KEY=your_salling_group_api_key_here
