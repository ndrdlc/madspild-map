# ── Vercel deployment (server-side, never exposed to the browser) ──────────────
# Set this in your Vercel project settings → Environment Variables
SALLING_API_KEY=your_salling_group_api_key_here

# ── Local development ──────────────────────────────────────────────────────────
# Option A (recommended): run `vercel dev` instead of `npm run dev`.
#   This starts both the Vite dev server and the /api/* serverless functions,
#   so SALLING_API_KEY above is enough.
#
# Option B: add your key here and run `npm run dev`.
#   The app will call the Salling API directly from the browser (no proxy).
# VITE_SALLING_API_KEY=your_salling_group_api_key_here
